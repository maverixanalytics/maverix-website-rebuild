---
/**
 * The .btn atom — circle-arrow + label (legacy btn() helper).
 * Styles live in styles/ported/btn.css (imported by SiteHeader, so the atom
 * is styled on every page that renders the chrome).
 */
type Props = {
  href: string;
  label: string;
  dark?: boolean;
};
const { href, label, dark = false } = Astro.props;
---

<a class:list={["btn", { "on-dark": dark }]} {href}>
  <span class="circ">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="#1A4A5D"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 5l7 7-7 7"></path>
      <path d="M12.5 5l7 7-7 7"></path>
    </svg>
  </span>
  <span class="btn-label">{label}</span>
</a>
