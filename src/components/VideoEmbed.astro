---
/**
 * YouTube embed — privacy-enhanced youtube-nocookie ONLY (a published
 * Privacy Policy commitment, plan §5.3), lazy-loaded.
 */
type Props = {
  title: string;
  youtubeId: string;
  /** Visible <h3> above the embed. Off when the pane holds a single video;
   *  the iframe keeps `title` for screen readers either way. */
  showTitle?: boolean;
};
const { title, youtubeId, showTitle = true } = Astro.props;
---

{showTitle && <h3 class="video-pane-title">{title}</h3>}
<iframe
  class="video-embed"
  src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
  {title}
  allowfullscreen
  loading="lazy"></iframe>
