---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { MvxForm, type MvxField } from "@/islands/MvxForm";
import {
  CONTACT_EMAIL,
  FORM_ENDPOINT,
  LI_MAVERIX,
  LI_THORACENT,
  SK_MAVERIX,
  SK_THORACENT,
} from "@/config/site.config";
import "@/styles/ported/category-shared.css";
import "@/styles/ported/hero-thin.css";
import "@/styles/ported/text-atoms.css";
import "@/styles/ported/careers.css";

/**
 * Careers page — port of build_careers() (legacy build.py ~1180-1258).
 * Body copy verbatim from legacy careers.html (entities → UTF-8); legacy
 * inline style="" attributes became the *-inline classes in careers.css.
 * The SociableKit divs stay STATIC (no island wraps them): the widget script
 * mutates them in place and the CSS `:not(:empty) + .jobs-empty` rule depends
 * on that third-party class + sibling position.
 */

const careersFields: MvxField[] = [
  {
    label: "Name",
    id: "cn",
    name: "Name",
    type: "text",
    required: true,
    placeholder: "Your name",
    autocomplete: "name",
    ariaLabel: "Name",
  },
  {
    label: "Email",
    id: "ce",
    name: "Email",
    type: "email",
    required: true,
    placeholder: "you@example.com",
    autocomplete: "email",
    ariaLabel: "Email",
  },
  {
    label: "Message",
    id: "cm",
    name: "Message",
    type: "textarea",
    rows: 5,
    required: true,
    placeholder: "Tell us about yourself",
    ariaLabel: "Message",
  },
];
---

<SiteLayout
  path="careers"
  title="Maverix Careers"
  description="Join us in revolutionizing lung cancer care. We are dedicated to improving care."
  dsSubtitle="Culture, benefits, open roles, join-us form"
>
  <div class="hero-thin">
    <img class="hero-img" src="/assets/cafe.jpg" alt="" />
    <div class="overlay"></div>
    <div class="container inner">
      <h1>careers</h1>
    </div>
  </div>

  <section class="band light">
    <div class="container">
      <h2 class="section-title">Join us in revolutionizing lung cancer care</h2>
      <p class="lede">
        At Maverix, we are dedicated to improving care by transforming the way
        lung cancer is diagnosed and treated. We aim to propel improved
        outcomes across the continuum of care.
      </p>
    </div>
  </section>

  <section class="band light row-line">
    <div class="container">
      <div class="split jobs-split split-start-inline">
        <div class="jobs-col">
          <h2 class="section-title section-title-blue-inline">
            Available Jobs at Maverix
          </h2>
          <div class="jobs-embed">
            {/* MUST stay truly empty (no whitespace child) — the
                `:not(:empty) + .jobs-empty` CSS rule depends on it */}
            <div class="sk-ww-linkedin-page-jobs" data-embed-id={SK_MAVERIX}
            ></div>
            <p class="jobs-empty">Loading open positions…</p>
          </div>
          <a class="btn joblink" href={LI_MAVERIX} target="_blank" rel="noopener">
            <span class="circ"
              ><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#1A4A5D"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M6 5l7 7-7 7"></path><path d="M12.5 5l7 7-7 7"
                ></path></svg
              ></span
            ><span class="btn-label">View all Maverix openings on LinkedIn</span>
          </a>
        </div>
        <div class="jobs-col">
          <h2 class="section-title section-title-blue-inline">
            Available Jobs at Thoracent
          </h2>
          <div class="jobs-embed">
            {/* MUST stay truly empty (no whitespace child) — see above */}
            <div class="sk-ww-linkedin-page-jobs" data-embed-id={SK_THORACENT}
            ></div>
            <p class="jobs-empty">Loading open positions…</p>
          </div>
          <a
            class="btn joblink"
            href={LI_THORACENT}
            target="_blank"
            rel="noopener"
          >
            <span class="circ"
              ><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#1A4A5D"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M6 5l7 7-7 7"></path><path d="M12.5 5l7 7-7 7"
                ></path></svg
              ></span
            ><span class="btn-label"
              >View all Thoracent openings on LinkedIn</span
            >
          </a>
        </div>
      </div>
    </div>
    {/* legacy position: INSIDE the section, after both embed divs */}
    <script
      is:inline
      src="https://widgets.sociablekit.com/linkedin-page-jobs/widget.js"
      defer></script>
  </section>

  <section class="band dark">
    <img class="bgimg" src="/images/careers-about.jpg" alt="" />
    <div class="container">
      <div class="kicker allcaps">About you</div>
      <div class="fullrule"></div>
      <div class="stackcol">
        <h2>Helping people breathe easier is hard.</h2>
        <p class="lede">
          We're looking for no-limit people, those who have deep expertise and
          broad interests, who take individual responsibility and sacrifice for
          the team, who create new opportunities and deliver on them, who
          attack every day with relentless pace and devotion to continual
          improvement.
        </p>
      </div>
    </div>
  </section>

  <section class="band light">
    <div class="container">
      <h2 class="section-title">Why work at Maverix?</h2>
      <div class="why-row">
        {/* the five ICONS inline SVGs verbatim from build.py */}
        <div class="why-cell">
          <svg viewBox="0 0 24 24"
            ><path d="M12 21v-8"></path><path
              d="M12 13c0-4 3-7 7-7 0 4-3 7-7 7z"></path><path
              d="M12 13c0-4-3-7-7-7 0 4 3 7 7 7z"></path></svg
          >
          <h3>Career Growth</h3>
          <p>
            We are committed to the professional development of our employees.
            At Maverix, you will have the opportunity to grow your skills, take
            on new challenges, and advance your career in a supportive and
            dynamic environment.
          </p>
        </div>
        <div class="why-cell">
          <svg viewBox="0 0 24 24"
            ><circle cx="9" cy="8" r="3"></circle><circle
              cx="17"
              cy="10"
              r="2.5"></circle><path d="M4 20c0-3 2.5-5 5-5s5 2 5 5"
            ></path><path d="M14 20c.2-2.5 1.8-4 3.5-4s3.3 1.5 3.5 4"
            ></path></svg
          >
          <h3>Collaborative Culture</h3>
          <p>
            We believe that success is collaborative. Our team combines diverse
            capabilities to achieve unrivaled impact.
          </p>
        </div>
        <div class="why-cell">
          <svg viewBox="0 0 24 24"
            ><path d="M6 18h12M9 21h6"></path><path d="M9 3l4 4-5 5-3-3z"
            ></path><path d="M13 7c3 1 5 3 5 6a5 5 0 0 1-5 5"></path></svg
          >
          <h3>Innovative Environment</h3>
          <p>
            Maverix transforms medical technology through targeted innovation.
            We develop products that change treatment paradigms and deliver
            meaningful clinical outcomes.
          </p>
        </div>
        <div class="why-cell">
          <svg viewBox="0 0 24 24"
            ><path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"
            ></path></svg
          >
          <h3>Impactful Work</h3>
          <p>
            By joining Maverix, you will be part of a team that is making a
            tangible impact on the fight against lung cancer. Our products are
            designed to improve patient outcomes and enhance the quality of
            care.
          </p>
        </div>
        <div class="why-cell">
          <svg viewBox="0 0 24 24"
            ><path d="M12 21v-9"></path><path d="M4 12a8 8 0 0 1 16 0z"
            ></path><path d="M8 12c0-4 2-8 4-8s4 4 4 8"></path></svg
          >
          <h3>Generous Benefits</h3>
          <p>
            We provide a comprehensive benefits package to help our team
            members thrive both professionally and personally.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark">
    <img class="bgimg" src="/images/careers-join.jpg" alt="" />
    <div class="container">
      <div class="kicker allcaps">Join us</div>
      <h2 class="join-heading-inline">Are you ready to make a difference?</h2>
      <p class="lede">
        Join a company that is at the forefront of lung cancer diagnosis and
        treatment.
      </p>
      <MvxForm
        client:visible
        variant="careers"
        name="careers"
        endpoint={FORM_ENDPOINT}
        mailto={CONTACT_EMAIL}
        fields={careersFields}
        submitLabel="Send message"
        submitClass="form-send-inline"
        wrapClass="form-wrap-inline"
      />
    </div>
  </section>
</SiteLayout>
