---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ContactBlock from "@/components/ContactBlock.astro";
import PCard from "@/components/PCard.astro";
import { diagnosisTools } from "@/data/productGroups";
import "@/styles/ported/category-shared.css";
import "@/styles/ported/hero-thin.css";
import "@/styles/ported/text-atoms.css";

/**
 * Diagnosis category page — served at /diagnosis. Was serpex.html until the
 * 2026-08-18 route rename; that legacy URL 301s here (netlify.toml).
 * Body ported verbatim from maverix-legacy/src/build.py serpex_body
 * (~L581+), entities → UTF-8.
 * Legacy renders the biopsy tools as a BARE .pgrid (pcards(DIAGNOSIS_TOOLS),
 * no .pgroup/.pglabel wrapper) — mirrored here with PCard, not PGroups.
 * The .nw-cta anchor is hand-rolled (legacy markup verbatim) because it
 * carries the extra `nw-cta` class Btn.astro doesn't accept.
 */
---

<SiteLayout
  path="diagnosis"
  title="Diagnosis – Maverix Medical"
  description="Endobronchial tissue-sampling instruments designed to help physicians obtain the tissue needed for an accurate diagnosis."
  dsGroup="Pages"
  dsSubtitle="Maverix Biopsy Tools — forceps, EBUS needles, cryobiopsy (Narwhal, Narwhal Pro)"
>
  <div class="hero-thin">
    <img class="hero-img" src="/images/diagnosis.jpg" alt="" />
    <div class="overlay"></div>
    <div class="container inner">
      <h1>diagnosis</h1>
    </div>
  </div>

  <section class="band light prod-section" id="maverix-biopsy-tools">
    <div class="container">
      <div class="sechead">
        <img
          class="famlogo"
          src="/assets/maverix-biopsy-tools-logo-color.png"
          alt="Maverix Biopsy Tools"
        />
        <div class="distby inline">
          <div class="seclabel">Distributed by</div>
          <img
            src="/assets/thoracent-by-maverix-logo.png"
            alt="Thoracent, a Maverix company"
          />
        </div>
        <ContactBlock showPhone={false} />
      </div>
      <div class="seclabel">About</div>
      <p class="biglead">An accurate diagnosis starts with adequate tissue.</p>
      <p class="bodytext">
        Maverix offers a suite of endobronchial instruments for interventional
        pulmonologists — from forceps for histological sampling of the airway
        wall, to ultrasound-guided needles for submucosal and extramural
        targets, to two console-free cryoprobes that take tissue biopsies by
        cryoadhesion and remove foreign bodies, mucus plugs, clots, and
        necrotic tissue.
      </p>

      <div class="seclabel">Products</div>
      <div class="pgrid">
        {
          diagnosisTools.map((item) => (
            <PCard
              slug={item.slug}
              name={item.name}
              image={item.image}
              abbr={item.abbr}
            />
          ))
        }
      </div>

      <div class="seclabel">Featured</div>
      {/* Content source: Narwhal Cryo Portfolio brochure LB361.B (Oct 2026). */}
      <section class="nwfeature">
        <div class="nw-top">
          <div class="nw-copy">
            <div class="nw-kicker">Narwhal™ Cryo Portfolio</div>
            <h2 class="nw-title">
              Expanding the Possibilities<br />of Cryobiopsy<span class="nw-dot"
                >.</span
              >
            </h2>
            <p class="nw-lede">
              Two console-free, single-use cryobiopsy probes and the cartridge
              that powers them. Handheld and self-contained, with no cryo
              console to purchase, service or wheel into the room. Both probes
              feature a 0.8&nbsp;mm OD probe tip.
            </p>
            <div class="nw-ctas">
              <a class="btn nw-cta" href="/products/narwhal-cryo-system">
                <span class="circ"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#1A4A5D"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M6 5l7 7-7 7"></path><path d="M12.5 5l7 7-7 7"
                  ></path></svg
                ></span
              ><span class="btn-label">Explore Narwhal</span>
              </a>
              <a class="btn nw-cta" href="/products/narwhal-pro-cryo-system">
                <span class="circ"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#1A4A5D"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M6 5l7 7-7 7"></path><path d="M12.5 5l7 7-7 7"
                  ></path></svg
                ></span
              ><span class="btn-label">Explore Narwhal Pro</span>
              </a>
            </div>
          </div>
          <div class="nw-shot">
            <img
              src="/images/narwhal/hero.jpg"
              alt="Narwhal cryoprobe tip"
              loading="lazy"
            />
          </div>
        </div>

        <div class="nw-body">
          <div class="nw-lineup">
            <a class="nw-lineitem" href="/products/narwhal-cryo-system">
              <img src="/images/narwhal/lineup-narwhal.jpg" alt="Narwhal cryobiopsy probe" loading="lazy" />
              <h3>Narwhal™</h3>
              <p>Cryobiopsy probe<br />3&nbsp;mm / 6&nbsp;mm selectable tip length</p>
            </a>
            <div class="nw-lineitem">
              <img src="/images/narwhal/lineup-cartridge.jpg" alt="Single-use Cryo cartridge" loading="lazy" />
              <h3>Cryo Cartridge</h3>
              <p>Single-use N<sub>2</sub>O refrigerant<br />Powers both probes</p>
            </div>
            <a class="nw-lineitem" href="/products/narwhal-pro-cryo-system">
              <img src="/images/narwhal/lineup-pro.jpg" alt="Narwhal Pro cryobiopsy probe" loading="lazy" />
              <h3>Narwhal™ Pro</h3>
              <p>Scope-mounted cryobiopsy probe<br />3&nbsp;mm fixed tip length, adjustable extension</p>
            </a>
          </div>

          <div class="nw-seclabel">
            Design innovations for efficiency and control
          </div>
          <h3 class="nw-evtitle">Everything cryobiopsy needs. Nothing it doesn’t.</h3>
          <p class="nw-evlede">
            Both Narwhal probes share key benefits: a pointed radiopaque tip, a
            single-use cryo cartridge in place of a console, and
            physician-adjustable probe length. Choose the probe that fits the
            scope and the case.
          </p>
          <div class="nw-cards">
            <div class="nw-card">
              <h3>No capital equipment.</h3>
              <div class="nw-cardimg">
                <img
                  src="/images/narwhal/cartridge.jpg"
                  alt="Single-use nitrous oxide Cryo cartridge"
                  loading="lazy"
                />
              </div>
              <p class="nw-what">
                Each probe is powered by a single-use nitrous oxide cartridge
                that hangs from an IV pole. No console to buy, service or
                schedule around.
              </p>
              <div class="nw-why">Why it matters</div>
              <p>
                Lower cost of entry, simpler setup, and one cartridge platform
                across both probes.
              </p>
            </div>
            <div class="nw-card">
              <h3>Sharp tip.</h3>
              <div class="nw-cardimg">
                <img
                  src="/images/narwhal/tips-both.jpg"
                  alt="Sharp, radiopaque tips of the Narwhal and Narwhal Pro probes"
                  loading="lazy"
                />
              </div>
              <p class="nw-what">
                A sharp, radiopaque tip on a reinforced shaft. Sheathed during
                placement, exposed only when you are ready to sample.
              </p>
              <div class="nw-why">Why it matters</div>
              <p>
                The sharp, radiopaque cryoprobe tip facilitates direct access
                for efficient biopsy sampling.
              </p>
            </div>
            <div class="nw-card">
              <h3>Purpose-built and adaptable.</h3>
              <div class="nw-cardimg">
                <img
                  src="/images/narwhal/dials-both.jpg"
                  alt="Narwhal tip-length dial and Narwhal Pro sheath extension adjuster"
                  loading="lazy"
                />
              </div>
              <p class="nw-what">
                <strong>Narwhal:</strong> select a ~3&nbsp;mm or ~6&nbsp;mm
                sampling tip length from an integrated dial.
                <strong>Narwhal Pro:</strong> mounts to the scope, adjusts
                working length to your bronchoscope, and sets sheath working
                length up to 4&nbsp;cm.
              </p>
              <div class="nw-why">Why it matters</div>
              <p>
                Ability to select optimal sampling technique without additional
                devices.
              </p>
            </div>
          </div>

          {/* Narwhal preclinical evidence: * markers bind stats to the .nw-foot disclaimer by adjacency — do not separate (plan §2.4 scheme #3) */}
          <div class="nw-seclabel evidence">Backed by preclinical testing</div>
          <h3 class="nw-evtitle">Two probes. Two studies. Every endpoint met.</h3>
          <p class="nw-evlede">
            In our preclinical animal studies, the Maverix Narwhal and Narwhal
            Pro cryobiopsy probes met every predefined endpoint for performance
            and safety, capturing high-quality samples with no clinically
            significant bleeding or pneumothorax observed.
          </p>

          <div class="nw-probe">
            <h4 class="nw-probename">Narwhal™ Cryobiopsy Probe</h4>
            <div class="nw-stats">
              <div class="nw-stat">
                <div class="nw-fig">100%</div>
                <p>All predefined performance endpoints met.</p>
              </div>
              <div class="nw-stat">
                <div class="nw-fig">0</div>
                <p>Pneumothorax or clinically significant bleeding events.*</p>
              </div>
              <div class="nw-stat">
                <div class="nw-fig">97%</div>
                <p>Avulsion success (36 of 37 attempts).</p>
              </div>
            </div>
            <div class="nw-tablewrap">
              <table class="nw-table">
                <thead>
                  <tr><th scope="col">Tip length</th><th scope="col">3-second freeze</th><th scope="col">5-second freeze</th><th scope="col">7-second freeze</th><th scope="col">Average biopsy weight</th></tr>
                </thead>
                <tbody>
                  <tr><th scope="row">3&nbsp;mm <span>(short)</span></th><td>3.2&nbsp;mg</td><td>8.6&nbsp;mg</td><td>10.0&nbsp;mg</td><td class="avg">7.3&nbsp;mg</td></tr>
                  <tr><th scope="row">6&nbsp;mm <span>(long)</span></th><td>8.5&nbsp;mg</td><td>13.9&nbsp;mg</td><td>14.9&nbsp;mg</td><td class="avg">12.4&nbsp;mg</td></tr>
                </tbody>
              </table>
            </div>
            <ul class="nw-bullets">
              <li>No pneumothoraxes through 2-hour endpoint.</li>
              <li>No clinically significant bleeding.</li>
              <li>Necropsy/pathology: no findings beyond expected biopsy site effects.</li>
              <li>Average fluoroscopy time of 32 seconds per biopsy.</li>
            </ul>
          </div>

          <div class="nw-probe">
            <h4 class="nw-probename">Narwhal™ Pro Cryobiopsy Probe</h4>
            <div class="nw-stats">
              <div class="nw-stat">
                <div class="nw-fig">100%</div>
                <p>All predefined performance endpoints met.</p>
              </div>
              <div class="nw-stat">
                <div class="nw-fig">0</div>
                <p>Pneumothorax or clinically significant bleeding events.*</p>
              </div>
              <div class="nw-stat">
                <div class="nw-fig">95%</div>
                <p>Avulsion success (36 of 38 attempts).</p>
              </div>
            </div>
            <div class="nw-tablewrap">
              <table class="nw-table">
                <thead>
                  <tr><th scope="col">Tip length</th><th scope="col">3-second freeze</th><th scope="col">5-second freeze</th><th scope="col">7-second freeze</th><th scope="col">Average biopsy weight</th></tr>
                </thead>
                <tbody>
                  <tr><th scope="row">3&nbsp;mm <span>(fixed)</span></th><td>5.1&nbsp;mg</td><td>6.7&nbsp;mg</td><td>9.1&nbsp;mg</td><td class="avg">7.0&nbsp;mg</td></tr>
                </tbody>
              </table>
            </div>
            <ul class="nw-bullets">
              <li>No pneumothoraxes through 2-hour endpoint.</li>
              <li>No clinically significant bleeding.</li>
              <li>Necropsy/pathology: no findings beyond expected biopsy site effects.</li>
              <li>Average fluoroscopy time of 20 seconds per biopsy.</li>
            </ul>
          </div>

          <p class="nw-foot">
            Data on file at Maverix (Narwhal: Test Report TR186; Narwhal Pro:
            Test Report TR271). Predefined performance endpoints: avulsion
            success rate, biopsy weight, usability, bleeding, pneumothorax,
            gross necropsy, histological accessibility, and percent
            artifact-free biopsy samples. Fluoroscopy time and radiation dose
            were also characterized in this analysis. *Minor bleeding was
            observed in some samplings; it was not clinically significant and
            met the pre-determined acceptance criteria. As with any
            cryosurgical procedure, bleeding and pneumothorax are potential
            risks. Refer to the Instructions for Use. Preclinical results may
            not be representative of clinical performance.
          </p>
        </div>
      </section>
      <p class="rxnote">
        All devices are prescription-only, for use by trained physicians. See
        each product’s Instructions for Use for complete indications,
        contraindications, warnings, and precautions.
      </p>
    </div>
  </section>
</SiteLayout>
