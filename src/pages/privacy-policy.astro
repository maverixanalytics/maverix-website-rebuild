---
import { getEntry, render } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import "@/styles/ported/category-shared.css";
import "@/styles/ported/text-atoms.css";

/** Legal prose lives in src/content/pages/privacy-policy.mdx (plan §2.5). */
const entry = await getEntry("pages", "privacy-policy");
if (!entry) throw new Error("Missing content entry: pages/privacy-policy");
const { Content } = await render(entry);
const { title, metaDescription, lastUpdated } = entry.data;
---

<SiteLayout
  path="privacy-policy"
  title={title}
  description={metaDescription}
  dsGroup="Legal"
  dsSubtitle="Privacy policy"
>
  <section class="band light">
    <div class="container legal legal-narrow-inline">
      <h1>Privacy Policy</h1>
      {lastUpdated && <div class="effective-date">Last updated: {lastUpdated}</div>}
      <Content />
    </div>
  </section>
</SiteLayout>
